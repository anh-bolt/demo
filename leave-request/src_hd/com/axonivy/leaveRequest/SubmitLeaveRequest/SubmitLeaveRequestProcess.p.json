    }, {
      "id" : "f4",
      "type" : "Script",
      "name" : "Calculate number of days",
      "config" : {
        "output" : {
          "code" : [
            "if (in.leaveRequest.getStartDate() != null && in.leaveRequest.getEndDate() != null) {",
            "  Long days = java.time.temporal.ChronoUnit.DAYS.between(in.leaveRequest.getStartDate(), in.leaveRequest.getEndDate()) + 1;",
            "  in.leaveRequest.setNumberOfDays(days.intValue());",
            "} else {",
            "  in.leaveRequest.setNumberOfDays(0);",
            "}"
          ]
        }
      },
